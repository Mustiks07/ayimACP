@model CosmeticsShop.Models.CreateProductViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Редактировать товар" : "Добавить товар";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/admin/products" class="btn-outline-brand" style="font-size:0.85rem">← Назад</a>
    <h1 style="font-size:1.5rem;font-weight:800;margin:0">@ViewData["Title"]</h1>
</div>

<div style="max-width:700px;background:var(--bg-white);border:1px solid var(--border);border-radius:var(--radius);padding:2rem">
    <form method="post" action="@(isEdit ? $"/admin/products/edit/{Model.Id}" : "/admin/products/new")">
        @Html.AntiForgeryToken()
        @if (isEdit) { <input type="hidden" asp-for="Id" /> }

        <div asp-validation-summary="All" class="alert-error-beauty mb-3"></div>

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Название *</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label class="form-label">Бренд *</label>
                <select asp-for="BrandId" class="form-select">
                    <option value="">Выберите бренд</option>
                    @foreach (var b in Model.Brands)
                    {
                        <option value="@b.Id" selected="@(Model.BrandId == b.Id ? "selected" : null)">@b.Title</option>
                    }
                </select>
                <span asp-validation-for="BrandId" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label class="form-label">Категория *</label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">Выберите категорию</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id" selected="@(Model.CategoryId == c.Id ? "selected" : null)">@c.IconEmoji @c.Title</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label class="form-label">Цена (₸) *</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label class="form-label">Ценовой диапазон</label>
                <select asp-for="PriceRange" class="form-select">
                    <option value="0">до 3000 ₸ (Бюджет)</option>
                    <option value="1">3000–10000 ₸ (Средний)</option>
                    <option value="2">10000–30000 ₸ (Премиум)</option>
                    <option value="3">от 30000 ₸ (Люкс)</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label">Объём / Вес</label>
                <input asp-for="Volume" class="form-control" placeholder="50ml, 30g..." />
            </div>
            <div class="col-6">
                <label class="form-label">Тип кожи</label>
                <input asp-for="SkinType" class="form-control" placeholder="Все типы, Сухая, Жирная..." />
            </div>
            <div class="col-12">
                <label class="form-label">URL изображения</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
            </div>
            <div class="col-12">
                <label class="form-label">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
            <div class="col-12">
                <div class="d-flex gap-4">
                    <div class="form-check">
                        <input asp-for="InStock" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">В наличии</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsBestseller" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Хит продаж</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsVerified" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Верифицирован</label>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn-brand">@(isEdit ? "Сохранить изменения" : "Добавить товар")</button>
            </div>
        </div>
    </form>
</div>
