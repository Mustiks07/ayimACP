@model List<CosmeticsShop.Domain.Entities.Product>
@{
    ViewData["Title"] = L.T("admin.products");
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 style="font-size:1.5rem;font-weight:800">@L.T("admin.products")</h1>
    <a href="/admin/products/new" class="btn-brand">+ @L.T("admin.add")</a>
</div>

<div style="background:var(--bg-white);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Фото</th>
                <th>Название</th>
                <th>Бренд</th>
                <th>Категория</th>
                <th>Цена</th>
                <th>Наличие</th>
                <th>Рейтинг</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="" style="width:48px;height:48px;object-fit:cover;border-radius:6px" />
                        }
                    </td>
                    <td>
                        <div style="font-weight:600">@p.Title</div>
                        @if (p.IsBestseller) { <span class="badge-bestseller">Хит</span> }
                    </td>
                    <td>@p.Brand?.Title</td>
                    <td>@p.Category?.Title</td>
                    <td>@p.Price.ToString("N0") ₸</td>
                    <td>@(p.InStock ? "Да" : "Нет")</td>
                    <td>@(p.Reviews.Count > 0 ? $"★ {p.AverageRating:0.0} ({p.ReviewCount})" : "—")</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="/admin/products/edit/@p.Id" class="vote-btn text-brand">Изменить</a>
                            <form method="post" action="/admin/products/delete/@p.Id" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="vote-btn" style="color:#EF4444"
                                        onclick="return confirm('Удалить товар?')">Удалить</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
