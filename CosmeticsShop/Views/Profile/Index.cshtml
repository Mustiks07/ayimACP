@{
    ViewData["Title"] = L.T("profile.title");
    var orders  = ViewBag.Orders  as List<CosmeticsShop.Domain.Entities.Order>  ?? new();
    var reviews = ViewBag.Reviews as List<CosmeticsShop.Domain.Entities.Review> ?? new();
}

<div class="container py-4">
    <h1 class="section-title">👤 @L.T("profile.title")</h1>

    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="rating-summary text-center">
                <div style="font-size:4rem;margin-bottom:0.5rem">👤</div>
                <div style="font-size:1.25rem;font-weight:700">@User.Identity?.Name</div>
                <div style="font-size:0.85rem;color:var(--text-muted);margin-top:0.25rem">
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge-verified">Администратор</span>
                    }
                    else
                    {
                        <span class="badge-price">Покупатель</span>
                    }
                </div>
                <div class="d-flex justify-content-around mt-3 pt-3" style="border-top:1px solid var(--border)">
                    <div class="text-center">
                        <div style="font-size:1.5rem;font-weight:800;color:var(--brand)">@orders.Count</div>
                        <div style="font-size:0.8rem;color:var(--text-muted)">Заказов</div>
                    </div>
                    <div class="text-center">
                        <div style="font-size:1.5rem;font-weight:800;color:var(--brand)">@reviews.Count</div>
                        <div style="font-size:0.8rem;color:var(--text-muted)">Отзывов</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-8">
            <!-- Recent Orders -->
            <h2 style="font-size:1.2rem;font-weight:700;margin-bottom:1rem">📦 @L.T("order.my_orders")</h2>
            @if (!orders.Any())
            {
                <p style="color:var(--text-muted)">@L.T("order.no_orders")</p>
            }
            else
            {
                @foreach (var order in orders.Take(5))
                {
                    var (label, css) = order.Status switch
                    {
                        CosmeticsShop.Domain.Enums.OrderStatusEnum.Pending    => (L.T("order.status_pending"),    "status-pending"),
                        CosmeticsShop.Domain.Enums.OrderStatusEnum.Processing => (L.T("order.status_processing"), "status-processing"),
                        CosmeticsShop.Domain.Enums.OrderStatusEnum.Shipped    => (L.T("order.status_shipped"),    "status-shipped"),
                        CosmeticsShop.Domain.Enums.OrderStatusEnum.Delivered  => (L.T("order.status_delivered"),  "status-delivered"),
                        _                                                      => (L.T("order.status_cancelled"),  "status-cancelled")
                    };
                    <div class="order-card">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <a href="/orders/details/@order.Id" class="fw-bold text-decoration-none" style="color:var(--text)">
                                    @L.T("order.number") #@order.Id
                                </a>
                                <div style="font-size:0.8rem;color:var(--text-muted)">@order.DateCreated.ToString("dd.MM.yyyy") · @order.Total.ToString("N0") ₸</div>
                            </div>
                            <span class="order-status @css">@label</span>
                        </div>
                    </div>
                }
                @if (orders.Count > 5)
                {
                    <a href="/orders" class="btn-outline-brand d-inline-block mt-1" style="font-size:0.85rem">
                        Все заказы (@orders.Count)
                    </a>
                }
            }

            <!-- Reviews -->
            <h2 style="font-size:1.2rem;font-weight:700;margin:1.5rem 0 1rem">💬 @L.T("profile.my_reviews")</h2>
            @if (!reviews.Any())
            {
                <p style="color:var(--text-muted)">@L.T("rev.no_reviews")</p>
            }
            else
            {
                @foreach (var review in reviews.Take(3))
                {
                    <div class="review-card">
                        <div class="review-header">
                            <div>
                                <a href="/products/show/@review.ProductId" class="text-decoration-none" style="color:var(--brand);font-size:0.85rem;font-weight:600">
                                    @review.Product?.Title
                                </a>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="stars sm">@(new string('★', review.Rating))</span>
                                    <span style="font-size:0.75rem;color:var(--text-muted)">@review.DateCreated.ToString("dd.MM.yyyy")</span>
                                </div>
                            </div>
                        </div>
                        <div class="review-title">@review.Title</div>
                        @if (!string.IsNullOrEmpty(review.Text))
                        {
                            <div class="review-text" style="max-height:60px;overflow:hidden">@review.Text</div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>
