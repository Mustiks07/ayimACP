<!DOCTYPE html>
<html lang="@L.Lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Admin | Beauty Shop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar-beauty">
        <div class="container d-flex align-items-center gap-3">
            <a href="/admin" class="brand-logo">💄 Beauty Admin</a>
            <div class="ms-auto d-flex gap-2 align-items-center">
                <a href="/" class="nav-link" style="font-size:0.85rem">← На сайт</a>
                <form method="post" action="/account/logout" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-outline-brand" style="font-size:0.85rem;padding:0.35rem 0.9rem">@L.T("nav.logout")</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="d-flex">
        <aside class="admin-sidebar">
            <nav class="nav flex-column">
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/admin") && Context.Request.Path == "/admin" ? "active" : "")"
                   href="/admin">📊 @L.T("admin.dashboard")</a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/products") ? "active" : "")"
                   href="/admin/products">🧴 @L.T("admin.products")</a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/orders") ? "active" : "")"
                   href="/admin/orders">📦 @L.T("admin.orders")</a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/reviews") ? "active" : "")"
                   href="/admin/reviews">💬 @L.T("admin.reviews")</a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/brands") ? "active" : "")"
                   href="/admin/brands">🏷️ @L.T("admin.brands")</a>
                <a class="nav-link @(Context.Request.Path.StartsWithSegments("/admin/categories") ? "active" : "")"
                   href="/admin/categories">📂 @L.T("admin.categories")</a>
            </nav>
        </aside>

        <main class="flex-1 p-4" style="flex:1">
            @if (TempData["Success"] != null)
            {
                <div class="alert-success-beauty auto-dismiss">✅ @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert-error-beauty auto-dismiss">❌ @TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>
