<!DOCTYPE html>
<html lang="@L.Lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Beauty Shop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

<nav class="navbar-beauty">
    <div class="container d-flex align-items-center gap-3">

        <a href="/" class="brand-logo me-2">
            Beauty<span>Shop</span>
        </a>

        <div class="d-flex align-items-center gap-1">
            <a href="/products" class="nav-link">@L.T("nav.products")</a>
            <a href="/home/brands" class="nav-link">@L.T("nav.brands")</a>
            <a href="/home/top" class="nav-link">Top</a>
        </div>

        <div class="d-flex align-items-center gap-2 ms-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/cart" class="nav-link">@L.T("nav.cart")</a>
                <a href="/orders" class="nav-link">@L.T("nav.orders")</a>
                <a href="/profile" class="nav-link">@L.T("nav.profile")</a>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin" class="btn-ghost ms-1" style="font-size:0.82rem;padding:0.35rem 0.85rem">
                        @L.T("nav.admin")
                    </a>
                }
                <form method="post" action="/account/logout" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-outline-brand" style="font-size:0.82rem;padding:0.38rem 0.9rem">
                        @L.T("nav.logout")
                    </button>
                </form>
            }
            else
            {
                <a href="/account/login" class="nav-link">@L.T("nav.login")</a>
                <a href="/account/register" class="btn-brand" style="font-size:0.85rem;padding:0.42rem 1.1rem">
                    @L.T("nav.register")
                </a>
            }

            <div class="d-flex gap-1 ms-2">
                <form method="post" action="/language/set">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <input type="hidden" name="lang" value="ru" />
                    <button type="submit" class="lang-btn @(L.Lang == "ru" ? "active" : "")">RU</button>
                </form>
                <form method="post" action="/language/set">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <input type="hidden" name="lang" value="kz" />
                    <button type="submit" class="lang-btn @(L.Lang == "kz" ? "active" : "")">KZ</button>
                </form>
            </div>
        </div>

    </div>
</nav>

<main>
    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert-success-beauty auto-dismiss">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert-error-beauty auto-dismiss">@TempData["Error"]</div>
        </div>
    }
    @RenderBody()
</main>

<footer>
    <div class="container">
        <p style="margin:0;font-weight:500">
            <strong style="color:var(--text)">Beauty Shop</strong> · Астана, @DateTime.Now.Year
        </p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
