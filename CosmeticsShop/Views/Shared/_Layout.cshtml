<!DOCTYPE html>
<html lang="@L.Lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Beauty Shop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar-beauty">
        <div class="container d-flex align-items-center gap-3 flex-wrap">
            <a href="/" class="brand-logo">💄 Beauty Shop</a>

            <div class="d-flex align-items-center gap-1 ms-auto">
                <a href="/products" class="nav-link">@L.T("nav.products")</a>
                <a href="/home/brands" class="nav-link">@L.T("nav.brands")</a>
                <a href="/home/top" class="nav-link">⭐ Top</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/cart" class="nav-link">🛒 @L.T("nav.cart")</a>
                    <a href="/orders" class="nav-link">@L.T("nav.orders")</a>
                    <a href="/profile" class="nav-link">@L.T("nav.profile")</a>
                    @if (User.IsInRole("Admin"))
                    {
                            <a href="/admin" class="nav-link text-brand fw-bold">@L.T("nav.admin")</a>
                    }
                    <form method="post" action="/account/logout" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-outline-brand ms-1" style="font-size:0.85rem;padding:0.35rem 0.9rem">@L.T("nav.logout")</button>
                    </form>
                }
                else
                {
                    <a href="/account/login" class="nav-link">@L.T("nav.login")</a>
                    <a href="/account/register" class="btn-brand ms-1" style="font-size:0.85rem;padding:0.35rem 0.9rem">@L.T("nav.register")</a>
                }
            </div>

            <div class="d-flex gap-1">
                <form method="post" action="/language/set">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <input type="hidden" name="lang" value="ru" />
                    <button type="submit" class="lang-btn @(L.Lang == "ru" ? "active" : "")">RU</button>
                </form>
                <form method="post" action="/language/set">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <input type="hidden" name="lang" value="kz" />
                    <button type="submit" class="lang-btn @(L.Lang == "kz" ? "active" : "")">KZ</button>
                </form>
            </div>
        </div>
    </nav>

    <main>
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert-success-beauty auto-dismiss">✅ @TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert-error-beauty auto-dismiss">❌ @TempData["Error"]</div>
            </div>
        }
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p class="mb-0">© @DateTime.Now.Year Beauty Shop — Астана. Все права защищены.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
