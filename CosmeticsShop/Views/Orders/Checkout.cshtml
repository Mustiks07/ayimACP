@model CheckoutViewModel
@{
    ViewData["Title"] = L.T("order.title");
}

<div class="container py-4">
    <h1 class="section-title">@L.T("order.title")</h1>

    <div class="row g-4">
        <div class="col-12 col-md-7">
            <div style="background:var(--bg-white);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem">
                <form method="post" action="/orders/checkout">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">@L.T("order.address") *</label>
                        <input asp-for="DeliveryAddress" class="form-control" placeholder="ул. Абая 1, кв. 10, Астана" />
                        <span asp-validation-for="DeliveryAddress" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L.T("order.phone") *</label>
                        <input asp-for="Phone" class="form-control" placeholder="+7 777 123 45 67" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L.T("order.comment")</label>
                        <textarea asp-for="Comment" class="form-control" rows="3" placeholder="Необязательно"></textarea>
                    </div>
                    <button type="submit" class="btn-brand w-100">@L.T("order.confirm")</button>
                </form>
            </div>
        </div>

        <div class="col-12 col-md-5">
            <div class="rating-summary">
                <h3 style="font-size:1.1rem;font-weight:700;margin-bottom:1rem">@L.T("order.summary")</h3>
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between mb-2" style="font-size:0.9rem">
                        <div>
                            <div style="font-weight:600">@item.Product.Title</div>
                            <div style="color:var(--text-muted);font-size:0.8rem">× @item.Quantity</div>
                        </div>
                        <span style="font-weight:600">@((item.Product.Price * item.Quantity).ToString("N0")) ₸</span>
                    </div>
                }
                <hr />
                <div class="d-flex justify-content-between align-items-center">
                    <strong>@L.T("cart.total")</strong>
                    <span style="font-size:1.5rem;font-weight:800;color:var(--brand)">@Model.Total.ToString("N0") ₸</span>
                </div>
            </div>
        </div>
    </div>
</div>
