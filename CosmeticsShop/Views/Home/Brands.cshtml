@model List<CosmeticsShop.Domain.Entities.Brand>
@{
    ViewData["Title"] = L.T("nav.brands");
}

<div class="container py-4">
    <h1 class="section-title">@L.T("nav.brands")</h1>

    <div class="row g-3">
        @foreach (var b in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <a href="/home/brandproducts/@b.Id" class="text-decoration-none">
                    <div class="admin-card h-100">
                        <div style="font-weight:700;font-size:1rem;color:var(--text)">
                            @b.Title
                            @if (b.IsVerified) { <span class="badge-verified ms-1">✓</span> }
                        </div>
                        @if (!string.IsNullOrEmpty(b.Country))
                        {
                            <div style="font-size:0.85rem;color:var(--text-muted);margin-top:0.25rem">@b.Country</div>
                        }
                        @if (!string.IsNullOrEmpty(b.Description))
                        {
                            <div style="font-size:0.8rem;color:var(--text-muted);margin-top:0.5rem">@b.Description</div>
                        }
                    </div>
                </a>
            </div>
        }
    </div>
</div>
