@{
    ViewData["Title"] = "Главная";
    var bestsellers = ViewBag.Bestsellers as List<CosmeticsShop.Domain.Entities.Product> ?? new();
    var categories  = ViewBag.Categories  as List<CosmeticsShop.Domain.Entities.Category> ?? new();
    var brands      = ViewBag.Brands      as List<CosmeticsShop.Domain.Entities.Brand> ?? new();
    int totalProducts = ViewBag.TotalProducts ?? 0;
    int totalBrands   = ViewBag.TotalBrands ?? 0;
    double avgRating  = ViewBag.AvgRating ?? 0.0;
}

<!-- Hero -->
<section class="hero">
    <div class="container">
        <h1>💄 @L.T("home.title")</h1>
        <p>@L.T("home.subtitle")</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a href="/products" class="btn-brand">🛍️ @L.T("nav.products")</a>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a href="/account/register" class="btn-outline-brand">@L.T("nav.register")</a>
            }
        </div>
    </div>
</section>

<div class="container">
    <!-- Stats -->
    <div class="stats-bar">
        <div class="stat-item">
            <span class="stat-num">@totalProducts</span>
            <span class="stat-label">@L.T("home.stat_products")</span>
        </div>
        <div class="stat-item">
            <span class="stat-num">@totalBrands</span>
            <span class="stat-label">@L.T("home.stat_brands")</span>
        </div>
        <div class="stat-item">
            <span class="stat-num">@(avgRating > 0 ? avgRating.ToString("0.0") : "—")</span>
            <span class="stat-label">@L.T("home.stat_rating")</span>
        </div>
    </div>

    <!-- Categories -->
    <section class="mt-4">
        <h2 class="section-title">@L.T("home.by_category")</h2>
        <div class="category-pills">
            @foreach (var cat in categories)
            {
                <a href="/products?CategoryId=@cat.Id" class="category-pill">
                    @cat.IconEmoji @cat.Title
                </a>
            }
        </div>
    </section>

    <!-- Bestsellers -->
    @if (bestsellers.Any())
    {
        <section class="mt-4">
            <h2 class="section-title">⭐ @L.T("home.bestsellers")</h2>
            <div class="row g-3">
                @foreach (var p in bestsellers)
                {
                    <div class="col-6 col-md-3">
                        <div class="product-card">
                            <a href="/products/show/@p.Id" class="text-decoration-none">
                                <div class="card-img-wrap">
                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="@p.Title" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100" style="font-size:3rem">💄</div>
                                    }
                                </div>
                            </a>
                            <div class="card-body">
                                <div class="card-brand">@p.Brand.Title</div>
                                <a href="/products/show/@p.Id" class="text-decoration-none">
                                    <div class="card-title">@p.Title</div>
                                </a>
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <span class="stars sm">@(new string('★', (int)Math.Round(p.AverageRating)))</span>
                                    <span style="font-size:0.75rem;color:var(--text-muted)">(@p.ReviewCount)</span>
                                </div>
                                <div class="card-price">@p.Price.ToString("N0") ₸</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- Brands -->
    <section class="mt-5">
        <h2 class="section-title">@L.T("home.all_brands")</h2>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var b in brands)
            {
                <a href="/home/brandproducts/@b.Id" class="brand-pill">
                    @b.Title @(b.IsVerified ? "✓" : "")
                    @if (!string.IsNullOrEmpty(b.Country))
                    {
                        <span style="color:var(--text-muted);font-weight:400"> · @b.Country</span>
                    }
                </a>
            }
        </div>
    </section>

    <!-- CTA for guests -->
    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="cta-section">
            <h2>@L.T("home.cta_title")</h2>
            <p>@L.T("home.cta_sub")</p>
            <a href="/account/register" class="btn-cta">@L.T("home.cta_btn")</a>
        </div>
    }
</div>
