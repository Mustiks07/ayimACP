@model List<CosmeticsShop.Domain.Entities.Product>
@{
    ViewData["Title"] = "Топ товаров";
}

<div class="container py-4">
    <h1 class="section-title">Топ товаров по рейтингу</h1>

    @if (!Model.Any())
    {
        <p class="text-muted">Пока нет товаров с отзывами.</p>
    }
    else
    {
        <div class="row g-3">
            @for (int i = 0; i < Model.Count; i++)
            {
                var p = Model[i];
                <div class="col-12 col-md-6">
                    <div class="product-card flex-row" style="flex-direction:row">
                        <div style="width:100px;min-width:100px">
                            <div class="card-img-wrap" style="aspect-ratio:1;height:100px">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Title" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100" style="font-size:0.75rem;font-weight:600;color:var(--brand)">Beauty</div>
                                }
                            </div>
                        </div>
                        <div class="card-body" style="flex-direction:row;align-items:center;gap:1rem">
                            <div class="me-auto" style="font-size:2rem;font-weight:800;color:var(--brand);min-width:2.5rem">
                                #@(i + 1)
                            </div>
                            <div class="flex-1">
                                <div class="card-brand">@p.Brand.Title</div>
                                <a href="/products/show/@p.Id" class="card-title text-decoration-none d-block">@p.Title</a>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="stars">@(new string('★', (int)Math.Round(p.AverageRating)))</span>
                                    <span style="font-weight:700;color:var(--brand)">@p.AverageRating.ToString("0.0")</span>
                                    <span style="font-size:0.8rem;color:var(--text-muted)">(@p.ReviewCount @L.T("prod.reviews_sfx"))</span>
                                </div>
                            </div>
                            <div>
                                <div class="card-price">@p.Price.ToString("N0") ₸</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
